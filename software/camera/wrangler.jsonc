{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "extruda-phone-camera",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "account_id": "c3018d276a4e26335bcab508b88ac7c0",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PairingRoom" }, { "name": "ABUSE", "class_name": "AbuseGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PairingRoom"] }, { "tag": "v2", "new_sqlite_classes": ["AbuseGuard"] }],
  "observability": { "enabled": false }
}
